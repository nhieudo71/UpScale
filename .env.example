# UpScale không đọc biến môi trường nào khi chạy. Cấu hình thật nằm trong config.toml
# (mẫu: config.example.toml). File này chỉ ghi lại biến mà bộ test dùng.
#
# Hai biến dưới đây điều khiển tests/fake_engine.py. Test tự đặt chúng bằng mock.patch.dict,
# nên không cần đặt tay. Chỉ đặt khi chạy thử fake_engine.py riêng.

# ok | dot | fail | oom | hang | wrongsize | nooutput
# ok = thành công, dot = tiến độ dạng "25.00%", fail = thoát mã 1, oom = lỗi bộ nhớ GPU,
# hang = treo 60 giây (thử hủy), wrongsize = ảnh sai kích thước, nooutput = không ghi file kết quả
FAKE_MODE=ok

# Số giây engine giả chờ trước khi ghi ảnh kết quả (số thực >= 0)
FAKE_DELAY=0
